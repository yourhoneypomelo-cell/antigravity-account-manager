{
  "name": "antigravity-account-manager",
  "description": "Local Google account and credential manager for Antigravity, with 2FA and subscription records.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
